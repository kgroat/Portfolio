{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": {
    "newlinesBetween": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles/app.css",
    "functions": ["cn"]
  },
  "ignorePatterns": ["old/**", "src/routeTree.gen.ts", "pnpm-lock.yaml", ".output/**", ".vercel/**"]
}
